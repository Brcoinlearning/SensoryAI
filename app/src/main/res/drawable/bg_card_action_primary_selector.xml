<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/primary_teal_light"
                android:endColor="@color/primary_teal" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="2dp"
                android:color="@color/status_success" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card_action_primary" />
</selector>