<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ARClient" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Night mode keeps the same AR-optimized palette -->
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorPrimaryVariant">@color/primary_deep_teal</item>
        <item name="colorOnPrimary">@color/surface_base</item>

        <item name="colorSecondary">@color/primary_teal_light</item>
        <item name="colorSecondaryVariant">@color/primary_teal</item>
        <item name="colorOnSecondary">@color/surface_base</item>

        <item name="android:colorBackground">@color/black</item>

        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>